{
  "name": "detectivedictator",
  "version": "1.0.0",
  "description": "An Online Version of the Mafia-style WWII Electon Game!",
  "repository": "https://github.com/FinnCowbell/DetectiveDictator.git",
  "author": "Finn Navin <Thomasfnavin@gmail.com>",
  "license": "MIT",
  "main": "./server/index.js",
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "DD_SERVER=\"\" DD_PORT=\"\" webpack --config webpack.config.js --mode production",
    "build-gh-pages": "DD_SERVER=dd-backend.finnnav.in DD_PORT=443 webpack --config webpack.config.js --mode production",
    "start-back": "node server/index.js -nofront",
    "build-dev": "webpack --config webpack.config.js --mode development",
    "test-local": "DD_SERVER=localhost DD_PORT=1945 webpack-dev-server --mode development",
    "test-front": "DD_SERVER=dd-backend.finnnav.in DD_PORT=443 webpack-dev-server --mode development",
    "test-back": "nodemon --watch server server/index.js -dev -nofront"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "compression-webpack-plugin": "^12.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-webpack-plugin": "^6.0.0",
    "favicons": "^7.3.1",
    "favicons-webpack-plugin": "^6.0.1",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "react-refresh": "^0.19.0",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.74.0",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "packageManager": "yarn@4.19.0",
  "resolutions": {
    "ws": "^8.23.0"
  },
  "engines": {
    "node": ">=22"
  }
